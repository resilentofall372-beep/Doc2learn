# Used by docker compose. Copy to .env and fill in.
# Any OpenAI-compatible provider works; the default is Google Gemini's free tier.

# --- Google Gemini free tier (default, no card needed) ---
# Key: https://aistudio.google.com/apikey
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
# Tried in order if the main model is overloaded, slow or retired
LLM_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.5-flash-lite,gemini-flash-latest
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- Alternative: Groq free tier ---
# Key: https://console.groq.com/keys
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL=https://api.groq.com/openai/v1

# --- Alternative: OpenRouter (free models end in :free) ---
# Key: https://openrouter.ai/keys
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# LLM_BASE_URL=https://openrouter.ai/api/v1

SECRET_KEY=change-me-to-a-long-random-string
# Set to false to skip downloading the embedding model at build time
PREFETCH_EMBEDDINGS=true
EMBEDDINGS_ENABLED=true

# --- Live quizzes with other devices on your Wi-Fi ---
# Replace 192.168.1.9 with your computer's address (run: hostname -I).
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://192.168.1.9:8080
PUBLIC_URL=http://192.168.1.9:8080
