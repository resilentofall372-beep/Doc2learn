# Used by docker compose. Copy to .env and fill in.
#
# Any OpenAI-compatible provider works. Pick ONE block.
#
# --- Option A: OpenRouter free models (no card needed) ---
# Key: https://openrouter.ai/keys   Free models: https://openrouter.ai/models?max_price=0
OPENROUTER_API_KEY=
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#
# --- Option B: Google Gemini free tier (no card needed) ---
# Key: https://aistudio.google.com/apikey
# OPENROUTER_API_KEY=your-gemini-key
# LLM_MODEL=gemini-2.0-flash
# OPENROUTER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#
# --- Option C: Groq free tier (no card needed, very fast) ---
# Key: https://console.groq.com/keys
# OPENROUTER_API_KEY=your-groq-key
# LLM_MODEL=llama-3.3-70b-versatile
# OPENROUTER_BASE_URL=https://api.groq.com/openai/v1

SECRET_KEY=change-me-to-a-long-random-string
# Set to false to skip downloading the embedding model at build time
PREFETCH_EMBEDDINGS=true
EMBEDDINGS_ENABLED=true
