# Copy to backend/.env and fill in.

# Required: OpenRouter key from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Any OpenRouter model id. Examples:
#   openai/gpt-4o-mini                       (default, cheap, strong JSON)
#   anthropic/claude-3.5-haiku
#   google/gemini-2.0-flash-001
#   meta-llama/llama-3.3-70b-instruct:free   (free tier, slower, rate limited)
LLM_MODEL=openai/gpt-4o-mini

# Change this to a long random string before exposing the app anywhere.
SECRET_KEY=change-me-in-production

# Local MongoDB (docker compose overrides this to mongodb://mongo:27017/doc2learn)
MONGO_URI=mongodb://localhost:27017/doc2learn

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Set to false to skip the ~130MB embedding model and use keyword retrieval only
EMBEDDINGS_ENABLED=true
